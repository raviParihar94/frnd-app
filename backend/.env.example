# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frnd_clone
PGSSL=false

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30
# SMS_PROVIDER: console | msg91 | fast2sms | firebase  (console is used for local/dev, no keys needed)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Redis (wired in Phase 3 — matchmaking queues / session state) ---
REDIS_URL=redis://localhost:6379

# --- Matchmaking economy (Phase 3) ---
QUEUE_TIMEOUT_SECONDS=20
TOKEN_TICK_INTERVAL_SECONDS=60
TEXT_CHAT_TOKENS_PER_MIN=5
VOICE_CALL_TOKENS_PER_MIN=10
VIDEO_CALL_TOKENS_PER_MIN=15

# --- Payments (wired in Phase 2) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- Media / Calls (Phase 4) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
AGORA_TOKEN_EXPIRE_SECONDS=3600
